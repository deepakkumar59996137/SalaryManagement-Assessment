# dependencies
node_modules/
.pnp
.pnp.js

# A leading slash anchors a pattern to the repository root. Without one, git
# matches a directory of that name at ANY depth — which is how `data/` silently
# excluded src/app/(app)/data, src/app/api/data and src/components/data, and
# shipped a repository whose CSV import/export screen 404'd in production while
# working perfectly on the machine that built it.
#
# Every entry below names a build artefact that only ever exists at the root, so
# every one of them is anchored. `node_modules/` deliberately is not: nested
# ones are real and should all be ignored.

# next.js
/.next/
/out/
/build/
next-env.d.ts

# database — generated by `npm run seed`, never committed
*.db
*.db-journal
*.db-wal
*.db-shm
/data/

# test & coverage
/coverage/
/test-results/
/playwright-report/
/blob-report/
/.playwright/

# env
.env
.env*.local

# misc
.DS_Store
*.pem
.vercel
*.tsbuildinfo

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# editor/agent tooling
.claude/
